      </link>

    </model>


    <!-- ================================================== -->
    <!-- BOX OBSTACLE 3                                     -->
    <!-- ================================================== -->

    <model name="box_obstacle_3">

      <static>true</static>

      <pose>7.0 0.0 0.60 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 1.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 1.2</size>
            </box>
          </geometry>

          <material>
