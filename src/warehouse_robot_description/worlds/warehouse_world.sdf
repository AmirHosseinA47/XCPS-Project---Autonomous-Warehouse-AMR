<?xml version="1.0"?>

<sdf version="1.9">

  <world name="warehouse_world">

    <!-- ================================================== -->
    <!-- WORLD SYSTEMS                                      -->
    <!-- ================================================== -->

    <physics name="physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>


    <!-- ================================================== -->
    <!-- LIGHT                                              -->
    <!-- ================================================== -->

    <light type="directional" name="sun">

      <cast_shadows>false</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


    <!-- ================================================== -->
    <!-- FLOOR                                              -->
    <!-- ================================================== -->

    <model name="ground_plane">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 24</size>
            </plane>
          </geometry>

        </collision>

        <visual name="ground_visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 24</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- OUTER WALLS                                        -->
    <!-- Warehouse dimensions: 18 m × 14 m                  -->
    <!-- ================================================== -->

    <model name="north_wall">

      <static>true</static>

      <pose>0 7 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>18 0.20 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>18 0.20 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <model name="south_wall">

      <static>true</static>

      <pose>0 -7 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>18 0.20 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>18 0.20 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <model name="east_wall">

      <static>true</static>

      <pose>9 0 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 14 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 14 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <model name="west_wall">

      <static>true</static>

      <pose>-9 0 1.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 14 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 14 2.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STORAGE RACK 1                                     -->
    <!-- ================================================== -->

    <model name="rack_1">

      <static>true</static>

      <pose>-5.5 2.8 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STORAGE RACK 2                                     -->
    <!-- ================================================== -->

    <model name="rack_2">

      <static>true</static>

      <pose>0 2.8 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STORAGE RACK 3                                     -->
    <!-- ================================================== -->

    <model name="rack_3">

      <static>true</static>

      <pose>5.5 2.8 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STORAGE RACK 4                                     -->
    <!-- ================================================== -->

    <model name="rack_4">

      <static>true</static>

      <pose>-5.5 -2.0 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STORAGE RACK 5                                     -->
    <!-- ================================================== -->

    <model name="rack_5">

      <static>true</static>

      <pose>0 -2.0 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STORAGE RACK 6                                     -->
    <!-- ================================================== -->

    <model name="rack_6">

      <static>true</static>

      <pose>5.5 -2.0 0.75 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 1.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.75 1</ambient>
            <diffuse>0.15 0.35 0.75 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- BOX OBSTACLE 1                                     -->
    <!-- ================================================== -->

    <model name="box_obstacle_1">

      <static>true</static>

      <pose>-2.5 -5.0 0.40 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.35 0.10 1</ambient>
            <diffuse>0.65 0.35 0.10 1</diffuse>
          </material>
        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- BOX OBSTACLE 2                                     -->
    <!-- ================================================== -->

    <model name="box_obstacle_2">

      <static>true</static>

      <pose>3.5 -4.5 0.50 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>

